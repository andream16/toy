{
  "name": "toy",
  "image": "mcr.microsoft.com/devcontainers/base:2.0.4-noble",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Toy API",
      "onAutoForward": "notify"
    }
  }
}
